    {"id": "ko_presenter", "label": "Korean: Kameleon Presenter page", "file_type": "document", "source_file": "/mnt/sda2/website/ko/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "chameleon_ai_platform", "label": "Chameleon AI Platform", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyQt6 desktop suite bundling seven disciplines (IDE, presenter, accounting, classroom, companion, logistics, web services) built local-first for freelancers and small businesses; licensing deliberately withheld pending finalisation, site carries testing disclaimers"},
    {"id": "chameleon_ai_ide", "label": "Chameleon AI IDE", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/ide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor-based replace_text edits chosen over line numbers because line numbers shift as code changes; untrusted-content markers wrap all file/terminal/web output to defend against prompt injection"},
    {"id": "kameleon_presenter", "label": "Kameleon Presenter", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Theatre metaphor (stage, actors, cues) with 0-10000 logical coordinates so presentations render identically on any display resolution"},
    {"id": "chameleon_companion_app", "label": "Chameleon Companion App", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single persistent WebSocket bridge (port 8770) carries eight independent channels as typed JSON so one Android phone becomes AI chat relay, presenter remote, file browser, media streamer and receipt scanner"},
    {"id": "logistics_4x4", "label": "Logistics 4x4", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately designed around the gap left by enterprise logistics platforms: small operators at remote border crossings need 4 SIM callers plus 4 P2P video peers in one call space on standard Android phones, with no per-seat billing or cloud relay"},
    {"id": "field_communication_code_protocol", "label": "Field Communication Code Protocol", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact letter+two-digit codes (severity 11 nominal to 99 critical) usable over SMS when data connectivity fails; three profiles (Driver, Hiker, Emergency services) share universal A/Z vocabulary and align with international P1-P4 triage and METHANE frameworks for cross-agency interoperability; A99+H99 is universal SOS"},
    {"id": "ai_web_services", "label": "AI Web Services", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five-tier service (build, domain, hosting, managed presence, growth); dedicated DNS tier exists because testing showed domain configuration caused the most user confusion (silent Google Domains to Squarespace migration, unfamiliar A/AAAA/CNAME record types)"},
    {"id": "uk_accounting_module", "label": "UK Accounting Module", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/accounting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double-entry SQLite ledger with UK chart of accounts, VAT codes S20/R5/Z/E/O, 6 April tax year, HMRC Notice 700 compliant invoicing and MTD-format VAT boxes; all reports emit structured JSON so the AI can parse and advise"},
    {"id": "ai_pc_technician", "label": "AI PC Technician", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surgical repair protocol: diagnose before touching, non-destructive first, verify each step, dead man's switch @reboot resume; USB driver porter picks path A (udev/modprobe), B (userspace hidraw/ALSA) or C (full DKMS kernel module with ARM cross-compile) based on how proprietary the device protocol is"},
    {"id": "language_classroom", "label": "Language Classroom", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/classroom.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines WebRTC group video, integrated Kameleon Presenter stage, pronunciation widget and Stripe/Alipay/PayPal enrolment in one desktop app; UK call-recording law (RIPA 2000) surfaced in-product via a recording banner because court admissibility requires informing all parties"},
    {"id": "tailscale_mesh", "label": "Tailscale Mesh Networking", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All channels run over the private tailnet so no ports open to the public internet; WireGuard end-to-end encryption; LAN/UDP fallback via lan_video.py when Tailscale unavailable"},
    {"id": "sim_call_bridge", "label": "SIM Call Bridge", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers the WebRTC call with Android's telecom stack alongside the SIM call so the native merge-call option hands audio mixing to telephony hardware; earpiece-only playback keeps merged calls private; Bluetooth SCO routing is the fallback when carrier hardware conferencing is unsupported"},
    {"id": "webrtc_full_mesh_video", "label": "WebRTC Full-Mesh Group Video", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full mesh chosen to avoid central media servers and monthly fees; adaptive grid (1 fullscreen, 2 side-by-side, 3 = 2+1, 4 = 2x2, 5+ scrollable) with per-peer bitrate scaling 1.5 Mbps down to 350 Kbps"},
    {"id": "chameleon_signal_server", "label": "Chameleon Signal Server", "file_type": "concept", "source_file": "/mnt/sda2/website/ja/classroom.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standalone SDP/ICE relay on port 8766 that also runs under Termux on Android, so a fleet phone can be both client and signalling node; zero-config hub election picks the lowest Tailscale IP when no PC is running; IDE beacon mode broadcasts UDP to force or offer connection"}
  ],
