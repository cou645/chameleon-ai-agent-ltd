    },
    {
      "id": "companion_assets_16chameleon_companion1709_chameleon_companion_app",
      "label": "Chameleon Companion (Android app)",
      "file_type": "concept",
      "source_file": "/mnt/sda2/website/companion-assets/16CHAMELEON-COMPANION1709.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "description": "Android phone app that connects to the Chameleon AI Technician IDE on a PC. Provides remote AI chat, terminal control, screen viewing, peer video calls, and classroom features over a private Tailscale network."
    },
    {
      "id": "companion_assets_16chameleon_companion1709_tailscale_mesh_vpn",
      "label": "Tailscale Private Mesh VPN Requirement",
      "file_type": "rationale",
      "source_file": "/mnt/sda2/website/companion-assets/16CHAMELEON-COMPANION1709.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Chameleon Companion REQUIRES a private mesh VPN; without it nothing will connect. Tailscale is the primary choice, with Headscale (self-hosted), ZeroTier, WireGuard, or LAN-only (same WiFi) listed as alternatives. All devices must sign in with the same account.",
      "description": "Hard prerequisite: install Tailscale on PC and all phones, sign in with the same account on all devices."
    },
    {
      "id": "companion_assets_16chameleon_companion1709_acl_device_tags",
      "label": "Tailscale ACL Device Tags (chameleon-ide / companion-app)",
      "file_type": "rationale",
      "source_file": "/mnt/sda2/website/companion-assets/16CHAMELEON-COMPANION1709.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Access control is tag-based: the PC is tagged chameleon-ide, phones are tagged companion-app, and the ACL must allow companion-app -> chameleon-ide on tcp:* and udp:*. This scopes connectivity to only the intended device roles.",
      "description": "In Tailscale Admin, tag the PC chameleon-ide and phones companion-app; verify ACL allows companion-app to reach chameleon-ide over TCP and UDP."
    },
    {
      "id": "companion_assets_16chameleon_companion1709_chameleon_ide",
      "label": "Chameleon AI Technician IDE (PC)",
      "file_type": "concept",
