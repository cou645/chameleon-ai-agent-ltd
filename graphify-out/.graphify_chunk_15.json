      "captured_at": null,
      "author": null,
      "contributor": null,
      "description": "Desktop IDE running on the PC that the Companion app connects to for remote AI chat, terminal control, and screen viewing."
    },
    {
      "id": "companion_assets_16chameleon_companion1709_chameleon_signal_server",
      "label": "chameleon_signal.py Signal Server",
      "file_type": "concept",
      "source_file": "/mnt/sda2/website/companion-assets/16CHAMELEON-COMPANION1709.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "description": "Signalling server started on the PC with 'python3 ~/chameleon/chameleon_signal.py &' as part of first-time setup; required before opening Chameleon Companion on the phone."
    },
    {
      "id": "companion_assets_16chameleon_companion1709_first_time_setup_flow",
      "label": "Companion First Time Setup Flow",
      "file_type": "concept",
      "source_file": "/mnt/sda2/website/companion-assets/16CHAMELEON-COMPANION1709.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "description": "Ordered setup sequence: 1) install Tailscale on phone and PC and join the same network, 2) start Chameleon IDE on the PC, 3) start chameleon_signal.py on the PC, 4) open Chameleon Companion on the phone."
    }
