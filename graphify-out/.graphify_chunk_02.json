    {"id": "de_technician_page", "label": "AI PC Technician Page (German)", "file_type": "document", "source_file": "/mnt/sda2/website/de/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "cy_codes_field_communication_code_protocol", "label": "Field Communication Code Protocol (letter + two-digit severity)", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact letter+two-digit codes (A11 nominal to X99 critical; A99+H99 universal SOS) let fleet drivers (D), hikers (H) and emergency services (X) communicate over SMS when data connectivity is gone; higher digits always mean more severe, and the Emergency Services profile deliberately aligns with international P1-P4 triage and the METHANE major-incident framework so cross-agency responders recognise the vocabulary immediately."},
    {"id": "cy_presenter_theatre_metaphor", "label": "Theatre Metaphor (Stage, Actors, Cues)", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presentations are modelled as stage productions - slides are a Stage, content blocks are Actors, transitions are numbered Cues - so entrances, exits, multi-script timelines and live peer submissions map onto familiar theatrical lighting-cue workflow; a 0-10,000 logical coordinate space makes presentations resolution-independent."},
    {"id": "cy_companion_sim_call_bridge", "label": "SIM Call Bridge (merge cellular and WebRTC calls)", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers the WebRTC call with the Android telecom stack alongside a live SIM call so the native 'Merge calls' option conferences them in the telephony hardware - earpiece-only for privacy - with Bluetooth SCO routing as fallback when the carrier lacks hardware conference support; lets a party unreachable by internet (customs officer, customer on a plain phone) join a P2P fleet or lesson call."},
    {"id": "cy_index_local_first_privacy", "label": "Local-First / Privacy-First Design", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All data (ledgers, chat history, project files, API keys in api_keys.env) stays under ~/.chameleon/ on the user's machine; nothing is sent to third-party servers unless a cloud AI provider is explicitly chosen, and local models via Ollama/LM Studio allow fully offline operation."},
    {"id": "cy_companion_multichannel_websocket_bridge", "label": "Multi-Channel WebSocket Bridge (chameleon_mobile_bridge, port 8770)", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single persistent WebSocket connection from the Android app to the desktop carries all channels (AI chat/IDE, P2P video signalling, remote presenter, screen mirror, file browser, media streaming, receipt capture, voice STT/TTS) as typed JSON messages over the private Tailscale mesh, with chameleon_signal.py runnable in Termux so no cloud relay is ever needed."},
    {"id": "cy_technician_usb_driver_porter", "label": "USB Driver Porter (Path A/B/C driver generation)", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profiles any USB device (usbmon on Linux, ETW on Windows, IOKit on macOS) then picks the least invasive generation path: Path A udev+modprobe config for standard classes (no compilation), Path B userspace hidraw/uhid daemon or ALSA plugin for partial vendor protocols, Path C full kernel module with DKMS packaging and ARM cross-compilation for fully proprietary protocols - escalating effort only as the protocol demands."},
    {"id": "cy_accounting_making_tax_digital", "label": "UK Double-Entry Ledger and Making Tax Digital", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/accounting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A local SQLite double-entry ledger with UK chart of accounts, VAT codes S20/R5/Z/E/O, the 6 April - 5 April tax year and HMRC Notice 700-compliant invoicing targets MTD VAT box output; all reports print structured JSON to stdout so the AI can parse and advise, and a forensic scan detects unbalanced entries and VAT mismatches."},
    {"id": "cy_index_tailscale_mesh", "label": "Tailscale Mesh Networking", "file_type": "concept", "source_file": "/mnt/sda2/website/cy/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All peer connections (video lessons, companion bridge, fleet comms, remote repair) run over the user's private WireGuard-encrypted Tailscale mesh with no public IPs or port forwarding; the IDE manages ACLs and device authorisation, and lan_video.py provides a UDP/WebSocket LAN fallback (ports 47731-47733) when Tailscale is unavailable."}
  ],
