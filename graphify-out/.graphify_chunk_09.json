    {"id": "uk_presenter_kameleon_presenter", "label": "Kameleon Presenter page (Ukrainian)", "file_type": "document", "source_file": "/mnt/sda2/website/uk/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},

    {"id": "sw_codes_field_communication_code_protocol", "label": "Field Communication Code Protocol (letter + two-digit severity)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact codes work over SMS when data connectivity is lost; low digits mean nominal, high digits mean critical, 99 is always the most severe, so meaning survives degraded channels and language barriers."},
    {"id": "sw_codes_universal_sos", "label": "Universal SOS (A99 + H99)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_codes_three_user_profiles", "label": "Three user profiles: Driver (D), Hiker (H), Emergency Services (X)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared alert and system vocabulary across profiles enables cross-agency communication; interoperability depends on all parties knowing the codes."},
    {"id": "sw_codes_methane_p1_p4_alignment", "label": "METHANE / P1-P4 triage standards alignment", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/codes.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emergency Services codes mirror international P1-P4 triage priorities and the METHANE major-incident framework so SAR and joint-services responders recognise the terminology immediately."},
    {"id": "sw_presenter_kameleonstack", "label": "KameleonStack universal content container (content/stage modes)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_presenter_theatre_metaphor", "label": "Theatre metaphor: Stage, Actors, Cues", "file_type": "rationale", "source_file": "/mnt/sda2/website/sw/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Presentations are structured like a stage production - objects have entrances, exits and numbered cues, like theatre lighting cues - making live, moderated, multi-participant presentations natural."},
    {"id": "sw_presenter_motion_path_smoothing", "label": "Freehand motion path smoothing (Douglas-Peucker + Catmull-Rom)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/presenter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_companion_multichannel_bridge", "label": "Multi-channel WebSocket bridge (port 8770, one persistent connection)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One persistent WebSocket connection carries all channels (IDE chat, P2P signalling, files, media, screen share) as typed JSON messages over the private Tailscale mesh - no ports opened to the public internet."},
    {"id": "sw_companion_sim_call_bridge", "label": "SIM Call Bridge (hardware conference + Bluetooth SCO fallback)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/companion.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers the WebRTC call with Android's telecom stack alongside the SIM call so the native 'merge calls' option mixes audio in phone hardware, earpiece-only for privacy; BT SCO routing is the fallback when carrier conference is unsupported."},
    {"id": "sw_classroom_webrtc_full_mesh", "label": "Full-mesh WebRTC group video (4+ participants, adaptive grid)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/classroom.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-mesh with per-peer bitrate scaling avoids any central media server and monthly cost; the chameleon_signal.py signalling server (port 8766) relays SDP/ICE and can run in Termux on a phone."},
    {"id": "sw_classroom_uk_call_recording_law", "label": "UK call recording law compliance (RIPA 2000, GDPR, recording banner)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/classroom.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a recording to be admissible in court all parties must be informed before it starts, so the Companion app shows a prominent RECORDING banner to all connected participants and verbal notice is required for SIM callers; audio is personal data under GDPR."},
    {"id": "sw_accounting_double_entry_ledger", "label": "Double-entry SQLite ledger (UK chart of accounts, 6 Apr-5 Apr tax year)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/accounting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_accounting_hmrc_notice_700_invoicing", "label": "HMRC Notice 700 compliant invoicing (12 mandatory fields, supply date)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/accounting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_accounting_mtd_vat_return", "label": "MTD VAT return summary (boxes 1, 4, 6, 7; codes S20/R5/Z/E/O)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/accounting.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_ide_ai_command_bridge", "label": "AI Command Bridge (structured JSON protocol driving the editor)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/ide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor-based replace_text edits reference exact text rather than line numbers because line numbers shift as code changes; get_file_content is read once and multiple edits are applied atomically."},
    {"id": "sw_ide_untrusted_content_protection", "label": "UNTRUSTED_CONTENT injection protection markers", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/ide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All content returned from files, terminals and web pages is wrapped in [UNTRUSTED_CONTENT] markers and treated as data, never instructions, to prevent prompt-injection attacks from malicious file content."},
    {"id": "sw_ide_company_command_station", "label": "Company Command Station (fleet office hub inside Chameleon IDE)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/ide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_logistics4x4_call_space_4x4", "label": "4x4 call space (4 SIM callers + 4 P2P video peers in one room)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fills the gap for small operators where enterprise fleet platforms do not reach - a driver at a remote border crossing can join customs (SIM), head office (video), a client abroad (SIM) and a convoy driver (video) simultaneously."},
    {"id": "sw_logistics4x4_ptt_live_translation", "label": "Push-to-talk live translation (Argos Translate on-device, 15 languages)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translation runs on a local Argos Translate server inside Termux on the phone so speech and text never leave the device and it works offline once language packs are installed."},
    {"id": "sw_logistics4x4_zero_config_hub_election", "label": "Zero-config hub election (lowest Tailscale IP becomes signalling hub)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_logistics4x4_ide_beacon_modes", "label": "IDE beacon modes (UDP broadcast: Mandatory / Optional / Off)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "sw_logistics4x4_emergency_sms_mode", "label": "Emergency Mode - coded frames over SMS and/or peer channel", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/logistics4x4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When cellular data is lost the app falls back to the compact code protocol over plain SMS; when data is available the same frames travel the peer channel; SOS always fires on every available channel regardless of the per-send selector."},
    {"id": "sw_technician_usb_driver_porter", "label": "USB Driver Porter (Paths A/B/C: udev, userspace daemon, kernel module)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path selection depends on how many vendor-specific pages the device profile reveals: none = udev/modprobe only, up to 2 = hidraw/uhid userspace daemon or ALSA plugin, fully proprietary = complete DKMS-packaged kernel module with ARM cross-compilation for Raspberry Pi."},
    {"id": "sw_technician_dead_mans_switch", "label": "Dead man's switch (@reboot auto-resume during risky repairs)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The surgical repair protocol is non-destructive first and verifies each step; any action requiring a reboot installs an @reboot resume script so remote repair over Tailscale survives restarts."},
    {"id": "sw_services_five_service_tiers", "label": "Five AI web service tiers (build, domain, hosting, managed presence, growth)", "file_type": "concept", "source_file": "/mnt/sda2/website/sw/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service 2 exists because DNS configuration caused the most confusion in the team's own testing (silent Google Domains to Squarespace migration, unfamiliar A/AAAA/CNAME records); Service 5 exists because a site nobody can find is worth little - services 1-4 build and launch, service 5 makes it discoverable."},
    {"id": "sw_index_local_first_privacy", "label": "Local-first / privacy-first principle (~/.chameleon/, no cloud dependency)", "file_type": "rationale", "source_file": "/mnt/sda2/website/sw/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All data - ledgers, chat history, trading positions - lives locally; nothing is sent to third-party servers unless a cloud AI provider is explicitly chosen, and API keys never leave the device."}
  ],
