{
  "nodes": [
    {"id": "zh_services_page", "label": "Web Services Page (Chinese)", "file_type": "document", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_services_ai_website_builder", "label": "Service 1: AI Website Builder", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No templates, no drag-and-drop: the AI reads the client's actual project files and docs so the site derives from what they really do; handover gives the client the files, repo and domain with no lock-in."},
    {"id": "zh_services_domain_configuration", "label": "Service 2: Domain Configuration", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DNS setup caused the most confusion in the company's own testing (domains silently migrated from Google Domains to Squarespace; A/AAAA/CNAME record types unfamiliar), so the AI asks for the registrar up front and gives registrar-specific step-by-step instructions requiring no prior DNS knowledge."},
    {"id": "zh_services_hosting_deployment", "label": "Service 3: Hosting Setup and Deployment", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal is zero monthly fees: free static hosting tiers or self-hosting on the client's own hardware, with a single deploy command (python3 github_pages.py deploy) or a 'deploy the website' chat request via the gh_deploy bridge action."},
    {"id": "zh_services_web_presence_management", "label": "Service 4: AI Web Presence Management", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_services_visibility_growth", "label": "Service 5: Visibility and Growth (SEO)", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A website nobody can find is worthless: services 1-4 build and run the site, service 5 makes it discoverable via SEO, structured data and analytics automated by AI instead of an ongoing agency retainer; privacy-respecting analytics (self-hosted Plausible/Umami) avoid cookie banners."},
    {"id": "zh_services_github_pages_hosting", "label": "GitHub Pages Hosting Option", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_services_cloudflare_pages_hosting", "label": "Cloudflare Pages Hosting Option", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_services_netlify_vercel_hosting", "label": "Netlify / Vercel Hosting Option", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_services_tailscale_self_hosting", "label": "Tailscale Funnel Self-Hosting Option", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serve the site from the client's own machine via Tailscale Funnel for public internet access with no cloud dependency and full control."},
    {"id": "zh_services_client_journey", "label": "Client Journey: Discovery, Build, Launch, Handover", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/services.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typical engagement is one build session with same-day go-live; every questionnaire question is plain language with examples so no web knowledge is required; handover is a one-page cheat sheet."},
    {"id": "zh_technician_page", "label": "AI PC Technician Page (Chinese)", "file_type": "document", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_technician_ai_guided_repair", "label": "AI-Guided System Repair", "file_type": "rationale", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI follows a structured surgical protocol: diagnose before touching anything, verify every step, never skip steps or make assumptions."},
    {"id": "zh_technician_diagnostic_sequence", "label": "Structured Diagnostic Sequence", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed order hardware -> kernel state -> driver state -> network -> storage; AI runs each step, reads JSON results, then decides the next action."},
    {"id": "zh_technician_surgical_repair_protocol", "label": "Surgical Repair Protocol with Deadman Switch", "file_type": "rationale", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive actions first (reload module, restart service), snapshot config before risky steps, verify after each; any action requiring reboot arms a deadman switch that installs an @reboot auto-recovery script."},
    {"id": "zh_technician_remote_repair_tailscale", "label": "Remote Repair over Tailscale", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI issues commands on remote machines through a terminal bridge over the Tailscale mesh, reads results and continues, surviving even reboots via a checkpoint/resume system."},
    {"id": "zh_technician_usb_driver_porter", "label": "USB Driver Porter", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profile any USB device, analyze its protocol, then generate a ready-to-install Linux driver; the generation path is chosen by how proprietary the observed protocol is."},
    {"id": "zh_technician_path_a_standard_protocol", "label": "Path A: Standard Protocol (udev + modprobe)", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No vendor pages found: generate udev rules plus modprobe config, no compilation needed; covers HID, CDC, mass storage and other standard classes."},
    {"id": "zh_technician_path_b_partial_vendor", "label": "Path B: Partial Vendor Protocol (userspace daemon)", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor pages detected (<=2): generate a hidraw/uhid userspace daemon or ALSA plugin, running in userspace so no kernel compilation is required."},
    {"id": "zh_technician_path_c_proprietary", "label": "Path C: Proprietary Protocol (full kernel module)", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully custom protocol: generate a complete kernel module with DKMS packaging and ARM cross-compilation targets for Raspberry Pi 3, 4 and 5."},
    {"id": "zh_technician_device_profiler_tool", "label": "device_profiler.py USB Capture Tool", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_technician_device_porter_tool", "label": "device_porter.py Driver Generator Tool", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "zh_technician_cross_platform_capture", "label": "Cross-Platform Capture Backends (ETW/IOKit/usbmon)", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profile on any OS (ETW on Windows, IOKit on macOS, usbmon on Linux) and still generate a Linux driver from the resulting profile.json."},
    {"id": "zh_technician_raspberry_pi_cross_compile", "label": "Raspberry Pi ARM Cross-Compilation", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makefile targets cross-aarch64 (Pi 4/5) and cross-armv7 (Pi 3) are included automatically on Path C so drivers can be built on x86 and deployed to ARM."},
    {"id": "zh_technician_dkms_packaging", "label": "DKMS Driver Packaging", "file_type": "concept", "source_file": "/mnt/sda2/website/zh/technician.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path C drivers are DKMS-packaged so they survive kernel upgrades without manual recompilation; the AI reviews analysis.json and prompts for any remaining TODO stubs."}
  ],
